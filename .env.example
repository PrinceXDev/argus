# ─── FalkorDB ────────────────────────────────────────────────────────────────
# FalkorDB Cloud (TLS):  falkors://<user>:<password>@<host>:<port>
# Local Docker:          falkor://localhost:6379
FALKORDB_URL=falkor://localhost:6379
FALKORDB_GRAPH=argus

# Read-only ACL user for the API process. Optional in dev; required for the
# database-side half of the security boundary. See docs/security.md.
FALKORDB_QUERY_USER=
FALKORDB_QUERY_PASS=

# ─── LLM + embeddings (OpenRouter serves both from one key) ──────────────────
# OpenRouter exposes an OpenAI-compatible /chat/completions AND /embeddings.
# Base URL: https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# Leave EMBED_API_KEY blank to reuse LLM_API_KEY (same provider).
# EMBED_DIM must match the model's output width and stay within FalkorDB's
# vector index limit of 1..4096. Changing it requires reindexing.
EMBED_PROVIDER=openrouter
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
EMBED_API_KEY=

# Optional OpenRouter attribution headers.
OPENROUTER_REFERER=https://github.com/prince/argus
OPENROUTER_TITLE=ARGUS

# ─── SEC EDGAR ───────────────────────────────────────────────────────────────
# The SEC rejects requests without a descriptive User-Agent containing a
# contact email. https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=ARGUS/0.1 (your-email@example.com)

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
DEMO_MODE=live
